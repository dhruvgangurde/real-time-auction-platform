# Host port mappings (container ports stay 8000 / 5432 / 6379)
API_HOST_PORT=8010
WEB_HOST_PORT=8011
# the web proxy's network and fixed address; the api trusts X-Forwarded-For from that address only
EDGE_SUBNET=10.201.0.0/24
WEB_PROXY_IP=10.201.0.10
# the WebSocket origin the CSP allows (wss://<host> once served over TLS)
WEB_WS_ORIGIN=ws://localhost:8011
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389

# Postgres container bootstrap (owner role, used only by migrations)
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction
POSTGRES_DB=auction

# Restricted application role, created by migration 0005 (DC-4)
APP_DB_USER=auction_app
APP_DB_PASSWORD=auction_app

# Application settings (NFR-26: config only via environment)
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://auction_app:auction_app@postgres:5432/auction
MIGRATION_DATABASE_URL=postgresql+asyncpg://auction:auction@postgres:5432/auction
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Bidding (FR-38: reject a manual bid from the current leader when true)
SELF_OUTBID_POLICY_ENABLED=true

# Identity (FR-5, NFR-17). JWT_SECRET must be at least 32 bytes outside APP_ENV=local.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:5173
# console (dev only, logs every email) or smtp. In Docker Compose, smtp goes to Mailpit, whose
# web UI is on MAILPIT_UI_HOST_PORT; production points SMTP_* at the chosen provider (TBD-1).
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=Auction <no-reply@auction.local>
MAILPIT_UI_HOST_PORT=8025

# Real-time layer (CI-4, NFR-27). ALIAS_SECRET must be at least 32 bytes outside APP_ENV=local.
ALIAS_SECRET=change-me-to-another-random-string-of-32-bytes
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8011

# Payments (FR-65 to FR-69): Razorpay TEST MODE keys only (rzp_test_...; live keys are refused).
# The webhook secret is the one set on the webhook in the Razorpay dashboard. Never commit them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Celery worker processes (default 4). Unset, Celery would start one per CPU.
CELERY_CONCURRENCY=4

# Demo mode (brief 12.3, 12.4): the demo endpoints and "Try to break it". Off by default; while
# off every demo endpoint answers 404. On, start the runner too: docker compose --profile demo up -d
DEMO_MODE=false

# seed-demo, local demo only: when set (10 to 128 characters), every seeded account signs in
# with this password and it is never printed; left empty, each run makes new ones, printed once
DEMO_ACCOUNTS_PASSWORD=
