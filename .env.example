# Host port mappings (container ports stay 8000 / 5432 / 6379)
API_HOST_PORT=8010
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389

# Postgres container bootstrap
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction
POSTGRES_DB=auction

# Application settings (NFR-26: config only via environment)
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://auction:auction@postgres:5432/auction
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
