# The web service (brief 12.5, 12.6 B1): one origin for the built SPA, the REST API, the
# WebSocket and /media, balanced across the two api instances (NFR-5). The api trusts
# X-Forwarded-For only from this proxy's fixed address (docker-compose.yml, WEB_PROXY_IP), so
# this proxy must overwrite it, never append to a value the client sent.
# ${WEB_WS_ORIGIN} is filled in by the nginx image's envsubst at start; nginx's own $variables
# are left alone because no environment variable has their names.

upstream api {
    zone api_upstream 64k;  # round-robin state shared by every worker
    server api:8000;
    server api-2:8000;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 6m;  # image uploads are capped at 5 MB (FR-13), plus multipart overhead

    # brief 13 item 24; on every response, errors included
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' ${WEB_WS_ORIGIN}; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    # inherited by the locations below that set no proxy headers of their own
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /api/v1/ws {
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 75s;  # the api pings every 20 s
        proxy_send_timeout 75s;
    }

    location /api/ {
        proxy_pass http://api;
    }

    location /media/ {
        proxy_pass http://api;
    }

    # the payment page (brief 13 item 25): its own document (frontend/pay.html, its own build) and
    # its own CSP, the only one that allows Razorpay; every other response keeps the policy above.
    # add_header here replaces the server-level ones, so the other two headers are repeated. Why
    # each Razorpay entry is there: docs/decisions.md, 2026-10-15 slice 3b.
    location ~ "^/auctions/[0-9a-f-]{36}/pay$" {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://lumberjack.razorpay.com https://lumberjack-metrics.razorpay.com; frame-src https://api.razorpay.com; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files /pay.html =404;
    }

    location / {
        try_files $uri /index.html =404;  # the SPA (frontend/dist, built in 10c)
    }
}
